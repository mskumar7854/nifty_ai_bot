# ==============================================================================
# NIFTY AI BOT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and populate your credentials.
#
# IMPORTANT:
# - Never commit your real '.env' file containing live secrets.
# - Dhan access tokens expire every 24 hours and must be refreshed daily.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DHAN BROKER CREDENTIALS (REQUIRED)
# ------------------------------------------------------------------------------
# Client ID: Found in your Dhan profile (e.g. 1100XXXXXX)
DHAN_CLIENT_ID=

# Access Token: Generate daily from https://dhanhq.co -> My Account -> API
DHAN_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 2. SYSTEM OPERATION MODE
# ------------------------------------------------------------------------------
# Options: SIMULATION (paper trading) | SMALL_CAPITAL (₹5k-10k live) | SCALED (full capital)
SYSTEM_MODE=SIMULATION

# Safety lock for live trades (required if mode is SMALL_CAPITAL or SCALED)
ALLOW_LIVE_TRADES=
CAMPAIGN_ID=

# ------------------------------------------------------------------------------
# 3. TRADING & DATA SETTINGS
# ------------------------------------------------------------------------------
SYMBOL=NIFTY
DATA_SOURCE=simulated
LOG_LEVEL=INFO

# Security IDs in Dhan master list (Defaults: NIFTY=13, BANKNIFTY=25)
NIFTY_SECURITY_ID=13
BANKNIFTY_SECURITY_ID=25

# ------------------------------------------------------------------------------
# 4. TELEGRAM ALERTS (OPTIONAL)
# ------------------------------------------------------------------------------
ENABLE_TELEGRAM_ALERTS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TRADING_MODE=AUTO

# ------------------------------------------------------------------------------
# 5. DASHBOARD (OPTIONAL)
# ------------------------------------------------------------------------------
DASHBOARD_ENABLED=true
DASHBOARD_PORT=5000
TELEMETRY_EMIT_INTERVAL_SECONDS=2.0
